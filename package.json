{
  "name": "seslitab",
  "version": "1.0.0",
  "type": "module",
  "description": "SesliTab — PDF/TAB to rhythmic text with voice playback",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "score:prepare-runtime": "node scripts/prepareScoreRuntime.js",
    "editor:prepare-runtime": "node scripts/prepareEditorRuntime.js",
    "smufl:prepare-assets": "node scripts/prepareSmuflKeypadAssets.js",
    "runtime:prepare": "npm run score:prepare-runtime && npm run editor:prepare-runtime && npm run ce-analysis:prepare-runtime && npm run ce-struct:prepare-runtime && npm run smufl:prepare-assets",
    "smoosic:prepare": "npm --prefix experiments/smoosic-mobile install --no-fund --no-audit && npm --prefix experiments/smoosic-mobile run build && node scripts/prepareSmoosicEditor.js",
    "build": "npm run runtime:prepare && npm run smoosic:prepare && vite build && node scripts/writeS16BuildCompositionManifest.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:s16:browser": "node --test --test-concurrency=1 browser-tests/s16ReadOnlyRequestGuard.browser.test.mjs",
    "verify:production-composition": "node scripts/verifyS16DeployedCompositionBrowser.js",
    "backend:start": "node backend/server.js",
    "backend:dev": "node --watch backend/server.js",
    "test:td06:emulator": "firebase emulators:exec --project demo-seslitab-td06 --only auth,firestore \"node --test tests/secureDeliveryFirestoreRules.test.js tests/secureDeliveryFirebaseEmulator.test.js tests/secureDeliveryPieceCascadeFirebaseEmulator.test.js tests/secureDeliveryDirectRepertoireFirebaseEmulator.test.js tests/secureDeliveryProvisioningFirebaseEmulator.test.js\"",
    "ce-struct:prepare-runtime": "node scripts/prepareCeStructRuntime.js",
    "ce-analysis:prepare-runtime": "node scripts/prepareCeAnalysisRuntime.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "14.4.0",
    "jszip": "^3.10.1",
    "multer": "2.4.0",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.0",
    "vite": "8.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
