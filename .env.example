# SesliTab — environment configuration example
# Copy this file to .env and adjust values as needed.

# OMR provider selection. Valid options: mock, audiveris, gateway
# "gateway" connects to the Express OMR Gateway backend (default).
# "mock" uses the in-browser fake provider.
# Set to "audiveris" when the real OMR engine is ready.
VITE_OMR_PROVIDER=gateway

# Express OMR Gateway base URL (no trailing slash). Used when VITE_OMR_PROVIDER=gateway.
# Production: the Render-hosted OMR gateway. Override only for local development.
VITE_OMR_GATEWAY_URL=https://seslitab-omr.onrender.com

# Supabase (optional, not used by the OMR flow)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only configuration (backend/backend/server.js) ---
# These are read by the Express OMR Gateway on the server side only.
# NEVER expose these to the frontend. Do NOT use VITE_ prefix.

# Backend OMR provider selection. Valid: mock, http, audiveris
# mock = safe default (no real recognition)
# http = remote OMR HTTP service
OMR_PROVIDER=mock

# Remote OMR HTTP service URL (required only when OMR_PROVIDER=http)
OMR_HTTP_API_URL=

# Remote OMR HTTP service API key (optional, sent as Authorization: Bearer)
OMR_HTTP_API_KEY=

# Remote OMR HTTP request timeout in milliseconds (default: 120000)
OMR_HTTP_TIMEOUT_MS=120000

# Audiveris command-line adapter (OMR_PROVIDER=audiveris)
# Executable name or absolute path (default: audiveris)
AUDIVERIS_COMMAND=audiveris
# Process timeout in milliseconds (default: 110000, below frontend 120s timeout)
AUDIVERIS_TIMEOUT_MS=110000
# Optional extra arguments (space-separated, passed as array — no shell)
AUDIVERIS_EXTRA_ARGS=

# --- Render / Docker persistent storage ---
# These configure where the Gateway stores job files and temporary Audiveris
# working directories. On Render, they point to the persistent disk mount.
SESLITAB_DATA_DIR=/var/lib/seslitab
SESLITAB_TEMP_DIR=/var/lib/seslitab/tmp
SESLITAB_MUSICXML_DIR=/var/lib/seslitab/musicxml

# --- Added by feature/auth-rate-limit ---
# API keys (comma-separated). Example: ALLOWED_API_KEYS=dev-secret-123,prod-key-xyz
ALLOWED_API_KEYS=
# Dev-only: set true to bypass API key checks (DO NOT enable in production)
ALLOW_OPEN_API=false
# Rate limiting configuration
RATE_LIMIT_WRITE_MAX=6
RATE_LIMIT_READ_MAX=120
